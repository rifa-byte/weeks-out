# Copy to .env (never commit .env). The app reads EXPO_PUBLIC_* at build time.
# URL of the deployed API (EAS Hosting), e.g. https://weeks-out--xxxx.expo.app
EXPO_PUBLIC_GENERATOR_URL=

# Server-only (set with `eas env:create --scope project --name ANTHROPIC_API_KEY --visibility secret`)
# ANTHROPIC_API_KEY=sk-ant-...
# GENERATOR_MODEL=claude-haiku-4-5
